    "",
    {
     "text": "¡Ah, por fin llegas! ",
     "color": "yellow"
    },
    "Soy el ",
    {
     "text": "Profesor Quark",
     "color": "yellow",
     "bold": true
    },
    ". Bienvenido a ",
    {
     "text": "Quanta",
     "color": "#b57bff",
     "bold": true
    },
    ", la región donde todo empieza."
   ],
   "choices": [
    {
     "text": "¿Qué es este lugar?",
