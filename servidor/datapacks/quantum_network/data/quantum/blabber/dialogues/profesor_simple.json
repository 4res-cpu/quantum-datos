  "saludo": {
   "text": [
    "",
    {
     "text": "¡Ah, por fin llegas! ",
     "color": "yellow"
    },
    "Soy el ",
    {
     "text": "Profesor Quark",
     "color": "yellow",
     "bold": true
    },
    ". Bienvenido a ",
    {
     "text": "Quanta",
     "color": "#b57bff",
     "bold": true
    },
    ", la región donde todo empieza."
   ],
   "choices": [
    {
     "text": "¿Qué es este lugar?",
     "next": "lore"
    },
    {
     "text": "Quiero mi primer Pokémon",
     "next": "region"
    }
   ]
  },
  "lore": {
   "text": [
    "",
    "Hace tiempo una ",
    {
     "text": "Fractura",
     "color": "#b57bff"
    },
    " rasgó el cielo de Quanta. Mira hacia arriba: esas grietas siguen abiertas. Por ellas llegan Pokémon de todas las regiones... y a veces, legendarios. Necesitamos entrenadores que nos ayuden a entenderla."
   ],
   "choices": [
    {
     "text": "Cuenta conmigo",
     "next": "region"
    }
   ]
  },
